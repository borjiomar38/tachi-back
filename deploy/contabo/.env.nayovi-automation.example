# Copy to /etc/nayovi-automation.env on the Contabo VPS (root-owned, mode 0640).
# Never commit a real webhook secret or mail credential.
NAYOVI_AUTOMATION_WEBHOOK_SECRET=
# Caddy reaches the host through Docker. The installer restricts this port to
# the tachi-proxy bridge with UFW; it remains unreachable from the Internet.
NAYOVI_AUTOMATION_LISTEN_HOST=0.0.0.0
NAYOVI_AUTOMATION_LISTEN_PORT=8790
NAYOVI_AUTOMATION_STATE_DIR=/var/lib/nayovi-automation
NAYOVI_AUTOMATION_LOG_DIR=/var/log/nayovi-automation
NAYOVI_AUTOMATION_WORKSPACE_ROOT=/opt/nayovi-automation

NAYOVI_CODEX_BIN=/usr/local/bin/codex
NAYOVI_CODEX_MODEL=gpt-5.6-sol
NAYOVI_CODEX_REASONING_EFFORT=xhigh
NAYOVI_CODEX_TIMEOUT_SECONDS=3600

NAYOVI_MOBILE_REPO_URL=https://github.com/borjiomar38/tachi-mobile.git
NAYOVI_SITE_REPO_URL=https://github.com/borjiomar38/tachi-back.git
NAYOVI_SITE_BUILD_ENV_FILE=/opt/tachi-back/.env.production

NAYOVI_GA_PROPERTY_ID=551184068
NAYOVI_OWNER_EMAIL=borjiomar38@gmail.com
NAYOVI_MAIL_ENV_FILE=/opt/tachi-back/.env.production
NAYOVI_GROWTH_ENV_FILE=/opt/tachi-back/.env.growth-agent
NAYOVI_IMAP_POLL_SECONDS=30
NAYOVI_PREVIEW_BASE_URL=https://staging.62.171.171.212.sslip.io
NAYOVI_STAGING_ENV_FILE=/opt/tachi-back-staging/.env.staging
NAYOVI_STAGING_SOURCE_DIR=/opt/tachi-back-staging
NAYOVI_PREVIEW_WAIT_SECONDS=900
